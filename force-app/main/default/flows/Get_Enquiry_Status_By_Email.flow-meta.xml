    <formulas>
        <name>closedDateText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Enquiry.Closed_Date__c}), &quot;&quot;, TEXT({!Get_Enquiry.Closed_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>NextStepText</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_Enquiry.Status__c}) = &quot;Closed&quot;, &quot;This enquiry is closed. You can raise a new enquiry if you need more help.&quot;, &quot;Our team will follow up with you shortly.&quot;)</expression>
    </formulas>
